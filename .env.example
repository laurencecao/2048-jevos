# Copy to .env.local if you need to override the defaults.
# For production deploy see docs/DEPLOY.md (deploy/install.sh writes deploy.env).

# Decision engine: jevos (default), ollama (9B), ollama27b (27B),
# startlux (9B) or startlux27b (27B)
AI_PROVIDER=jevos

# jevos: local CPU, OpenVINO int8
JEVOS_URL=http://127.0.0.1:8017
JEVOS_MODEL=jev-latest
# dev:all looks here first (default: <repo>/.jevos/jev)
JEVOS_DIR=.jevos/jev
JEVOS_THREADS=4

# ollama: same /v1/systemone protocol for decision models (clef-flash:9b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=clef-flash:9b
# keep the model resident between moves (cold load is ~110 s)
OLLAMA_KEEP_ALIVE=30m

# ollama 27B: same daemon, decision model clef:27b (27B, Q4_K_M, ~18 GB).
# It does not fit on one 16 GB card, so ollama must spread it over the four
# GPUs: bash deploy/ollama-gpu.sh apply  (sets OLLAMA_SCHED_SPREAD=1)
OLLAMA27_URL=http://127.0.0.1:11434
OLLAMA27_MODEL=clef:27b
# optional per-engine residency override (falls back to OLLAMA_KEEP_ALIVE)
# OLLAMA27_KEEP_ALIVE=30m

# startlux: two StartLux-Decision GGUFs behind startlux-decide serve (llama.cpp).
# Both stay resident at the same time (bash deploy/startlux-both.sh start):
#   9B  Q8_0  llama-server 8018 -> decision API 8081  (provider startlux)
#   27B Q4_K_M llama-server 8019 -> decision API 8082  (provider startlux27b)
STARTLUX_URL=http://127.0.0.1:8081
STARTLUX_MODEL=StartLux-Decision-v1.1-9B-Instant
STARTLUX27_URL=http://127.0.0.1:8082
STARTLUX27_MODEL=StartLux-Decision-v1.1-27B-Instant

PORT=3000

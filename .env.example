# Copy to .env.local if you need to override the defaults.
# For production deploy see docs/DEPLOY.md (deploy/install.sh writes deploy.env).

# Decision engine: jevos (default), ollama or startlux
AI_PROVIDER=jevos

# jevos: local CPU, OpenVINO int8
JEVOS_URL=http://127.0.0.1:8017
JEVOS_MODEL=jev-latest
# dev:all looks here first (default: <repo>/.jevos/jev)
JEVOS_DIR=.jevos/jev
JEVOS_THREADS=4

# ollama: same /v1/systemone protocol for decision models (clef-flash:9b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=clef-flash:9b
# keep the model resident between moves (cold load is ~110 s)
OLLAMA_KEEP_ALIVE=30m

# startlux: StartLux-Decision GGUF behind startlux-decide serve (llama.cpp)
# 8081 is the decision API; llama-server itself usually listens on 8018.
STARTLUX_URL=http://127.0.0.1:8081
STARTLUX_MODEL=StartLux-Decision-v1.1-9B-Instant

PORT=3000
